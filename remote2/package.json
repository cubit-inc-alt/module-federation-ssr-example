{
  "name": "server-side-rendering_remote2",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "webpack --mode production --config config/webpack.client.js",
    "build:server": "webpack --mode production --config config/webpack.server.js",
    "serve": "npx serve dist/ -p 3002",
    "start": "pnpm build && pnpm serve",
    "dev": "webpack serve --mode development --config config/webpack.dev.js --hot --port 3009",
    "watch": "webpack --watch --mode development --config config/webpack.client.js",
    "dev:alt": "webpack serve --config config/webpack.dev.js --mode development --open --hot",
    "dev:stable": "webpack serve --config config/webpack.dev.js --mode development --hot --no-client-overlay",
    "dev:hmr": "webpack serve --config config/webpack.dev.js --mode development --hot --no-client-overlay --no-stats",
    "dev:enhanced": "webpack serve --config config/webpack.dev.js --mode development --hot --no-client-overlay --no-stats --open",
    "dev:pure": "webpack serve --config config/webpack.hmr.js --mode development --hot"
  },
  "license": "MIT",
  "author": {
    "name": "anjitpariyar",
    "email": "anjitpariyar@gmail.com"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-transform-runtime": "7.24.7",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@module-federation/node": "2.6.8",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "babel-loader": "^9.2.1",
    "html-webpack-plugin": "5.6.0",
    "react-refresh": "^0.14.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2",
    "webpack-merge": "6.0.1"
  },
  "dependencies": {
    "@babel/runtime": "^7.13.10",
    "react": "^18.1.0",
    "react-dom": "^18.1.0"
  }
}
